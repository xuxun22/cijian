# 复制为服务器上的 .env（勿提交仓库）。
# 各值生成方法见文档仓 docs/06-security.md §密钥清单。

# 登录口令的 argon2id hash
CIJIAN_PASSPHRASE_HASH=

# JWT 签名密钥（openssl rand -hex 32）
CIJIAN_JWT_SECRET=

# 签名文件下载 URL 密钥（独立于 JWT；openssl rand -hex 32）
CIJIAN_FILE_URL_SECRET=

# SQLite + files 根目录
CIJIAN_DATA_DIR=/opt/cijian-api/data

PORT=8787
